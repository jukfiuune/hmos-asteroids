+VKAPI_ATTR VkResult VKAPI_CALL
+tu_AllocateMemory(VkDevice handle, const VkMemoryAllocateInfo *info,
+                  const VkAllocationCallbacks *alloc, VkDeviceMemory *memory)
+{
+   VK_FROM_HANDLE(tu_device, device, handle);
