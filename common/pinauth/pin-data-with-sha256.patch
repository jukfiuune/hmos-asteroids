 constexpr uint32_t AUTH_PIN = 1;
 
 constexpr size_t MAX_SCHEDULE_SIZE = 50;
+// asteroids: Huawei's PIN input library (libpinauth_framework) sends the 64-byte scrypt result followed by the PIN's
+// SHA-256 (OpenHarmony's InputerDataImpl::GetSha256, appended at the end), at least when authenticating; the PIN
+// database works on the scrypt result, so a 96-byte buffer is taken for its first 64 bytes.
+constexpr size_t PIN_DATA_WITH_SHA256_LEN = CONST_PIN_DATA_LEN + 32;
+
+bool IsPinDataLen(size_t len)
+{
+    return len == CONST_PIN_DATA_LEN || len == PIN_DATA_WITH_SHA256_LEN;
+}
 }
 
